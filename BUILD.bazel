load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "log_analyzer_lib",
    srcs = [
        "src/format_policies.cpp",
        "src/log_entry.cpp",
        "src/statistics.cpp",
    ],
    hdrs = [
        "include/async_parser.h",
        "include/filter.h",
        "include/formatter.h",
        "include/format_policies.h",
        "include/log_cache.h",
        "include/log_entry.h",
        "include/log_iterator.h",
        "include/log_parser.h",
        "include/statistics.h",
    ],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
    ],
    includes = ["include"],
    visibility = ["//tests:__pkg__"],
)

cc_binary(
    name = "log_analyzer",
    srcs = ["src/main.cpp"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Werror",
    ],
    deps = [":log_analyzer_lib"],
)
